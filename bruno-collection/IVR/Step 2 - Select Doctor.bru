meta {
  name: Step 2 - Select Doctor
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/ivr/step
  body: form-urlencoded
  auth: none
}

body:form-urlencoded {
  CallSid: {{callSid}}
  From: {{patientPhone}}
  To: {{ivrPhoneNumber}}
  Digits: 1
}

docs {
  Patient selects doctor option 1.
  Server queries available dates for the chosen doctor and responds with the Date Selection menu.
}
