# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database / cache ---
# Use 127.0.0.1, not localhost — Node can resolve "localhost" to ::1 first on
# Windows/WSL2 + Docker Desktop, which silently races/fails against the
# working IPv4 port-forward and causes intermittent multi-second connection
# stalls (seen locally: ~26-30s before falling back).
DATABASE_URL=postgresql://wap:wap@127.0.0.1:5432/wap
REDIS_URL=redis://127.0.0.1:6379

# --- Meta WhatsApp Cloud API ---
# Verify token you choose yourself and enter into the Meta App Dashboard webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret, used to verify X-Hub-Signature-256 on inbound webhooks
WHATSAPP_APP_SECRET=
# Permanent (or long-lived) access token for the Graph API calls
WHATSAPP_ACCESS_TOKEN=
# Graph API version, e.g. v21.0
WHATSAPP_API_VERSION=v21.0
# Override for local/dev testing (point at a mock server); defaults to real Meta
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

# --- Booking bot behavior ---
# How many days ahead patients may book / staff may generate slots for
BOOKING_HORIZON_DAYS=14
